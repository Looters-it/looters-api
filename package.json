{
  "name": "looters-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx --env-file-if-exists=.env src/seed/run.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "load": "tsx --env-file-if-exists=.env scripts/load-test.ts",
    "load:duels": "tsx --env-file-if-exists=.env scripts/duel-load.ts",
    "regions": "tsx --env-file-if-exists=.env scripts/split-italy-regions.ts",
    "areas:fetch": "tsx scripts/fetch-countries.ts",
    "areas:split": "tsx --env-file-if-exists=.env scripts/split-regions.ts",
    "areas:classify": "tsx --env-file-if-exists=.env scripts/classify-isolated.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/websocket": "^11.3.3",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "d3-delaunay": "^6.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@11.13.1"
}
