# PostgreSQL + PostGIS. With docker compose the host is `db:5432`; from the host machine `localhost:5433`.
DATABASE_URL=postgresql://gioco:gioco@localhost:5433/gioco

# Optional: enables the integration tests (`pnpm test`). Must point to a migrated, disposable database.
TEST_DATABASE_URL=postgresql://gioco:gioco@localhost:5433/gioco_test

# Kafka carries the battle resolution queue to `jobs`. Comma-separated list of brokers.
# With docker compose `kafka:9092`; from the host machine `localhost:29092`.
KAFKA_BROKERS=localhost:29092
# Topic of the battle queue; it is created by the `kafka-init` service of docker compose.
KAFKA_BATTLE_TOPIC=battle.resolve

# Optional: enables the Kafka integration test (`pnpm test`).
TEST_KAFKA_BROKERS=localhost:29092

# HTTP port and bind address of the API.
PORT=3000
HOST=0.0.0.0

# Log level: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# Directory shared with `jobs` where uploaded geo files are stored.
UPLOAD_DIR=./uploads

# Platform admin, created or updated by `pnpm seed`. There is no other way to create an admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_EMAIL=admin@example.test
